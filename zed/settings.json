// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // General Options
  "format_on_save": "off",
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "relative_line_numbers": "disabled",
  "project_panel": {
    "dock": "left",
    "button": false, // Hides the file tree toggle button
    "entry_spacing": "comfortable", // Spacing in file tree: "dense", "standard", "comfortable"
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "ssh_connections": [
    {
      "host": "github-quunarc",
      "args": [],
      "projects": [],
    },
    {
      "host": "100.76.39.1",
      "username": "q",
      "args": [],
      "projects": [
        {
          "paths": ["/home/q"],
        },
      ],
    },
  ],
  "agent": {
    "dock": "right",
    "always_allow_tool_actions": true,
    "default_model": {
      "provider": "google",
      "model": "gemini-2.5-flash",
    },
    "model_parameters": [],
  },
  "scrollbar": {
    "show": "auto", // Options: "auto", "always", "never"
  },
  "tab_bar": {
    "show": true, // Turn off to hide file tabs entirely
    "file_icons": true, // Toggles language icons on tabs
  },
  "toolbar": {
    "breadcrumbs": false, // Hides the file path path-tracker at the top
    "quick_actions": false, // Hides top-right action buttons (like run/play)
  },
  "status_bar": {
    "show": true, // Turn off to hide the bottom information bar
  },
  "ui_font_size": 15,
  "buffer_font_size": 14,
  "buffer_font_family": "FiraCode Nerd Font",
  "vim_mode": true,
  "terminal": {
      "default_height": 9999
  },

  // "theme": {
  //   "mode": "system",
  //   "light": "One Light",
  //   "dark": "Vague",
  // },
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Iced Latte (Blur)",
    "dark": "Catppuccin Espresso (Blur) [Light]",
  },

  "load_direnv": "direct",

  // LSP Settings
  "lsp": {
    "omnisharp": {
      "binary": {
        // "path": "/nix/store/79c0za5s3fr11isxd90jvww188dry5h5-omnisharp-roslyn-1.39.14/bin/OmniSharp",
        "path": "OmniSharp",
        "arguments": ["--languageserver"],
      },
    },
  },
  "languages": {
    "CSharp": {
      "language_servers": ["omnisharp", "!roslyn", "..."],
    },
  },
}
